// Cloudflare Workers static-assets deploy. Build: `npm run build`; deploy: `npx wrangler deploy`.
// Having this file stops Wrangler's auto-configuration (which requires Vite >= 6).
{
  "name": "mach-overdrive",
  "compatibility_date": "2026-10-01",
  // Build here too, so the deploy works even if the dashboard build command is empty.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
